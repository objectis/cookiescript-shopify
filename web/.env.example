APP_NAME="cookie-script"
APP_ENV=production
APP_KEY=
APP_DEBUG=false

SCOPES_READ=read_script_tags,write_script_tags,read_themes,write_themes

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=sqlite
# The path to the database file should be absolute, make sure to update it!
DB_DATABASE=/home/shopify/public_html/web/storage/db.sqlite
DB_FOREIGN_KEYS=true
HOST=shopify.cookie-script.com
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Set to a current version (e.g. 2026-07) after testing on a development store
SHOPIFY_REST_API_VERSION=2023-04
